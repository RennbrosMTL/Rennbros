# Renn Bros website: the settings it reads.
# Copy to .env.local for local work, or add each one in Netlify
# (Project configuration > Environment variables).
# Never commit real values: .env* files are git-ignored except this example.

# --- Square bookings (server only) ---------------------------------------
# Without these the site runs on a stand-in calendar and says so ("preview").

# Square Developer > Credentials > Production access token. SECRET.
SQUARE_ACCESS_TOKEN=
# "production" or "sandbox"
SQUARE_ENVIRONMENT=production
# Square Developer > Locations
SQUARE_LOCATION_ID=
# Optional: only this staff member's calendar
SQUARE_TEAM_MEMBER_ID=
# JSON map, site service slug -> Square service variation ID,
# e.g. {"oil-change":"ABC123","tires":"DEF456"}
SQUARE_SERVICES=

# --- Square card field for the deposit (public, read at build time) ------

# Square Developer > Credentials > Application ID
NEXT_PUBLIC_SQUARE_APP_ID=
# Same Location ID as above
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=production

# --- Site options (public, read at build time) ---------------------------

# Which hero video the home page shows: "fall" or "winter"
NEXT_PUBLIC_HERO_SEASON=fall
# Optional: use Google Maps instead of the free OpenFreeMap map
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
